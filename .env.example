# Copy to .env and fill in. .env is gitignored -- never commit a real key.
#
# You do not need this file at all: `ragvid config --set-key groq` stores keys
# in ~/.local/share/ragvid/settings.json (mode 0600), and so does the Settings
# panel in `ragvid serve`. Keys set that way take precedence over this file.

# Which provider grades use. See `ragvid config` for the full list.
RAGVID_PROVIDER=groq

# Key for the provider you picked. Only the one in use is read.
GROQ_API_KEY=gsk_your_key_here
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your_key_here
# XAI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# TOGETHER_API_KEY=
# (ollama runs locally and needs no key)

# Override the provider's default model.
# RAGVID_MODEL=openai/gpt-oss-120b

# Any other OpenAI-compatible endpoint, without a code change.
# RAGVID_BASE_URL=https://your-endpoint/v1
# RAGVID_API_KEY=

# Point at a specific ffmpeg/ffprobe instead of the one on PATH.
# RAGVID_FFMPEG=/usr/local/bin/ffmpeg
# RAGVID_FFPROBE=/usr/local/bin/ffprobe
