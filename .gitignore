.env
.venv/
__pycache__/
*.pyc
.ragvid/
out/
*.cube
assets/*.mp4
assets/*.png
# fixtures are generated by tests/conftest.py, never committed
.pytest_cache/
*.egg-info/

# scratch media + generated comparison output; regenerate via test_files/output/build_page.py
test_files/output/
test_files/*.gif
test_files/*.png

# agent worktrees
.claude/

# render outputs -- regenerable, never source. test_files/test.mp4 stays tracked:
# scripts/build_looks.py derives the whole look corpus from it, so dropping it
# would make the corpus unreproducible.
test_files/*-graded*.mp4

# build artifacts + tool caches -- all regenerable
build/
dist/
.mypy_cache/
.ruff_cache/
.DS_Store
